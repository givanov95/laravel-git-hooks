#!/usr/bin/env bash
#
# laravel-git-hooks — pre-commit quality gate.
# Installed by the givanov95/laravel-git-hooks Composer package.
#
# Steps (each is skipped gracefully when its tooling is absent):
#   1. php-cs-fixer on the fully staged PHP files
#   2. debug-statement guard (console.log() / dd() / dump() calls; paths in .debug-guard-ignore are skipped)
#   3. Vite build — only when frontend files are staged
#   4. test suite (php artisan test, or vendor/bin/phpunit)
#
# Skip individual steps:  SKIP_CSFIXER=1 / SKIP_DEBUG_GUARD=1 / SKIP_BUILD=1 / SKIP_TESTS=1 git commit ...
# Skip every step:        SKIP_HOOK=1 git commit ...
# Bypass the hook itself:  git commit --no-verify

set -uo pipefail

# Colours — empty when stdout is not an interactive terminal.
if command -v tput >/dev/null 2>&1 && [ -t 1 ]; then
    RED=$(tput setaf 1); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RESET=$(tput sgr0)
else
    RED=""; GREEN=""; YELLOW=""; RESET=""
fi

# Run from the repository root so relative tool paths resolve correctly.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "Not inside a git repository."; exit 1; }
cd "$ROOT" || exit 1

if [ "${SKIP_HOOK:-0}" = "1" ]; then
    echo "${YELLOW}laravel-git-hooks: SKIP_HOOK=1 — skipping all checks.${RESET}"
    exit 0
fi

staged() { git diff --cached --name-only --diff-filter=ACM; }

# ── 1. php-cs-fixer ────────────────────────────────────────────────────────
cs_config=""
for candidate in .php-cs-fixer.php .php-cs-fixer.dist.php; do
    [ -f "$candidate" ] && cs_config="$candidate" && break
done

if [ "${SKIP_CSFIXER:-0}" != "1" ] && [ -x vendor/bin/php-cs-fixer ] && [ -n "$cs_config" ]; then
    # Only fully staged files are formatted. A file that also has unstaged edits (git add -p) is
    # skipped: the fixer would rewrite hunks left out of this commit and re-staging it would pull
    # them in. NUL-separated so paths with spaces survive; no mapfile, for bash 3.2 on macOS.
    fix_files=()
    partial_files=()
    while IFS= read -r -d '' file; do
        if git diff --quiet -- "$file"; then
            fix_files+=("$file")
        else
            partial_files+=("$file")
        fi
    done < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.php')

    if [ "${#partial_files[@]}" -gt 0 ]; then
        echo "${YELLOW}php-cs-fixer: skipping partially staged files (they have unstaged changes):${RESET}"
        printf '  %s\n' "${partial_files[@]}"
    fi

    if [ "${#fix_files[@]}" -gt 0 ]; then
        echo "Running php-cs-fixer..."
        PHP_CS_FIXER_IGNORE_ENV=1 vendor/bin/php-cs-fixer fix --config="$cs_config" --path-mode=intersection --using-cache=yes -q -- "${fix_files[@]}"
        # Re-stage what the fixer rewrote — only the files that were handed to it.
        git add -- "${fix_files[@]}"
    fi
fi

# ── 2. debug-statement guard ───────────────────────────────────────────────
if [ "${SKIP_DEBUG_GUARD:-0}" != "1" ]; then
    # Only calls count: `->dump(`, `::dump(`, `$dump(`, `obj.dump(`, `Foo\dump(` and `function dump(`
    # are not debug statements. Whole-line comments (//, #, *, /*, <!--) are ignored; a comment
    # trailing code on the same line is not recognised. The staged content is what gets scanned,
    # not the working tree. Paths in .debug-guard-ignore (one git pathspec per line) are skipped.
    debug_call='(^|[^[:alnum:]_>:$.\\])\\?(dd|dump)[[:space:]]*\(|(^|[^[:alnum:]_$])console\.log[[:space:]]*\('

    guard_excludes=()
    if [ -f .debug-guard-ignore ]; then
        while IFS= read -r pattern || [ -n "$pattern" ]; do
            pattern=${pattern%$'\r'}
            case "$pattern" in '' | '#'*) continue ;; esac
            guard_excludes+=(":(exclude)$pattern")
        done < .debug-guard-ignore
    fi

    offenders=""
    while IFS= read -r -d '' file; do
        while IFS=: read -r number _; do
            offenders+="${file}:${number}"$'\n'
        done < <(
            git show ":$file" 2>/dev/null \
                | sed -E -e 's/^[[:space:]]*(\/\/|#|\*|\/\*|<!--).*$//' -e 's/function[[:space:]]+&?[[:space:]]*(dd|dump)[[:space:]]*\(/function (/g' \
                | grep -n -E "$debug_call"
        )
    done < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.php' '*.vue' '*.js' '*.ts' ${guard_excludes[@]+"${guard_excludes[@]}"})

    if [ -n "$offenders" ]; then
        echo "${RED}Commit contains console.log() / dd() / dump() calls:${RESET}"
        printf '%s' "$offenders" | while IFS= read -r hit; do echo "  ${YELLOW}${hit}${RESET}"; done
        echo "${RED}Remove them, list the path in .debug-guard-ignore, or run with SKIP_DEBUG_GUARD=1 (git commit --no-verify skips the whole hook).${RESET}"
        exit 1
    fi
fi

# ── 3. Vite build (only when frontend files are staged) ────────────────────
if [ "${SKIP_BUILD:-0}" != "1" ] && [ -f package.json ] && command -v npm >/dev/null 2>&1; then
    if grep -q '"build"' package.json && staged | grep -qE '\.(vue|js|ts|jsx|tsx|css|scss|html)$'; then
        echo "Frontend changes detected — running build..."
        if ! npm run build; then
            echo "${RED}Error: build failed. Commit aborted.${RESET}"
            exit 1
        fi
        echo "${GREEN}Build succeeded.${RESET}"
    fi
fi

# ── 4. tests ───────────────────────────────────────────────────────────────
if [ "${SKIP_TESTS:-0}" != "1" ]; then
    if [ -f artisan ]; then
        echo "Running tests (php artisan test)..."
        if ! php artisan test; then
            echo "${RED}Error: tests failed. Commit aborted.${RESET}"
            exit 1
        fi
        echo "${GREEN}Tests passed.${RESET}"
    elif [ -x vendor/bin/phpunit ]; then
        echo "Running tests (phpunit)..."
        if ! vendor/bin/phpunit; then
            echo "${RED}Error: tests failed. Commit aborted.${RESET}"
            exit 1
        fi
        echo "${GREEN}Tests passed.${RESET}"
    fi
fi

echo "${GREEN}laravel-git-hooks: all checks passed.${RESET}"
exit 0
